# ============================================================
# Frontend environment variables — copy to .env.local and fill in values
# Set these as Vercel environment variables for production deployment
# ============================================================

# Backend API base URL (Railway production)
# Format: https://<your-railway-backend>.up.railway.app/api
NEXT_PUBLIC_API_BASE_URL=https://web-production-7458d.up.railway.app/api

# Backend base URL (without /api suffix) — used by lib/api.ts server components
NEXT_PUBLIC_API_URL=https://web-production-7458d.up.railway.app

# Backend base URL for auth (without /api suffix)
NEXT_PUBLIC_BETTER_AUTH_URL=https://web-production-7458d.up.railway.app

# Local development defaults (used if .env.local is not present)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:8000

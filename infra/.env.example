# Kubernetes Deployment — Required Secrets
# This file documents the secrets needed for Kubernetes deployment.
# DO NOT put real values here. This file is safe to commit.
#
# To create the Kubernetes secret before Helm install, run:
#   kubectl create secret generic todo-secrets \
#     --from-literal=NEON_DB_URL='<your-neon-db-url>' \
#     --from-literal=BETTER_AUTH_SECRET='<your-auth-secret>' \
#     --from-literal=COHERE_API_KEY='<your-cohere-api-key>'
#
# Verify the secret was created:
#   kubectl get secret todo-secrets
#   kubectl describe secret todo-secrets

# PostgreSQL connection string from Neon (https://neon.tech)
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
NEON_DB_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Better Auth secret key (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=your-random-32-char-secret-here

# Cohere API key (from https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your-cohere-api-key-here

# ---
# Non-sensitive config (managed via ConfigMap, not Secret)
# These are set in infra/helm/*/values.yaml:
#   DEBUG=false
#   LOG_LEVEL=info
#   BETTER_AUTH_URL=http://todo-frontend:3000
#   NEXT_PUBLIC_API_BASE_URL=http://<minikube-ip>:<backend-nodeport>/api
#   NEXT_PUBLIC_BETTER_AUTH_URL=http://<minikube-ip>:<frontend-nodeport>

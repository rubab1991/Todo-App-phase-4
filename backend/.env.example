# Todo Backend — Environment Variables (Phase V)
# Copy to .env and fill in values. NEVER commit .env to source control.

# --- Database ---
NEON_DB_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Authentication ---
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# --- AI Services ---
COHERE_API_KEY=your-cohere-api-key

# --- Dapr Runtime (injected by Dapr sidecar in K8s; set manually for local dev) ---
DAPR_HTTP_PORT=3500
DAPR_APP_ID=todo-backend

# --- Recurring Engine (internal self-call) ---
INTERNAL_API_BASE=http://localhost:8000

# --- Application ---
DEBUG=false
LOG_LEVEL=info
